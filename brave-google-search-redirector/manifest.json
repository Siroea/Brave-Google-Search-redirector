{
  "manifest_version": 3,
  "name": "Brave Google Search Redirector",
  "version": "1.0.0",
  "description": "Braveブラウザのアドレスバー検索（Yahoo!等）を自動的にGoogle検索へ強制転送します。",
  "permissions": [
    "webNavigation",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.yahoo.co.jp/*",
    "*://*.yahoo.com/*",
    "*://*.bing.com/*",
    "*://*.duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.yahoo.co.jp/search*",
        "*://*.yahoo.com/search*",
        "*://*.bing.com/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Search Redirector Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "omnibox": {
    "keyword": "g"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
